NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333
API_PUBLIC_URL=http://localhost:3333
API_PORT=3333
INBOUND_WEBHOOKS_ENABLED=false
INBOUND_WEBHOOK_ENCRYPTION_KEY=
INBOUND_WEBHOOK_REPLAY_ENABLED=false
INBOUND_WEBHOOK_PRODUCTION_ENABLED=false
INBOUND_CONVERSION_RULES_ENABLED=false
INBOUND_CONVERSION_PRODUCTION_ENABLED=false
WPPTRACK_API_SLOW_REQUEST_MS=1500
WPPTRACK_API_SLOW_REPORT_QUERY_MS=750
WPPTRACK_WEB_SLOW_REQUEST_MS=1500
WPPTRACK_WEB_PROVIDER_STATUS_TIMEOUT_MS=2000
WPPTRACK_EXTERNAL_SYNC_ENABLED=true
WPPTRACK_EXTERNAL_SYNC_INTERVAL_MINUTES=1
WPPTRACK_EXTERNAL_SYNC_INITIAL_DELAY_SECONDS=60
WPPTRACK_EXTERNAL_SYNC_CONNECTOR_LIMIT=50
WPPTRACK_EXTERNAL_SYNC_ROW_BATCH_SIZE=200
WPPTRACK_EXTERNAL_MYSQL_CONNECT_TIMEOUT_MS=5000
WPPTRACK_EXTERNAL_MYSQL_QUERY_TIMEOUT_MS=10000

DATABASE_URL=postgresql://rastrackdash:rastrackdash@localhost:5432/rastrackdash
REDIS_URL=redis://localhost:6379
EXTERNAL_CONNECTOR_ENCRYPTION_KEY=replace-me-external-connector-encryption-key

JWT_ACCESS_SECRET=replace-me-access-secret
JWT_REFRESH_SECRET=replace-me-refresh-secret
AUTH_PUBLIC_REGISTRATION_ENABLED=false
AUTH_GOOGLE_ENABLED=false
AUTH_COOKIE_DOMAIN=localhost
AUTH_EXPOSE_DEV_TOKENS=false
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=RastrackDash
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_REPLY_TO=support@example.com

WPPTRACK_PLATFORM_ADMIN_EMAILS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-me-google-state-secret

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_TOKEN_ENCRYPTION_KEY=replace-me-meta-token-encryption-key
META_WEBHOOK_VERIFY_TOKEN=
WPPTRACK_META_AUTO_SYNC_ENABLED=true
WPPTRACK_META_AUTO_SYNC_INTERVAL_MINUTES=180
WPPTRACK_META_AUTO_SYNC_INITIAL_DELAY_SECONDS=60
WPPTRACK_META_AUTO_SYNC_LOOKBACK_DAYS=7
WPPTRACK_META_AUTO_SYNC_BATCH_LIMIT=100
WPPTRACK_REPORT_TIMEZONE=America/Sao_Paulo

UAZAPI_BASE_URL=
UAZAPI_TOKEN=
UAZAPI_WEBHOOK_AUTH_TOKEN=

# WhatsApp providers (F5 plan, apps/api/src/integrations/whatsapp-providers):
# uazapi_byo uses the UAZAPI_* vars above (your own Uazapi instance token).
# nod_api is the PalmUP-managed broker (below). waha and zapi are pure BYO
# adapters for a self-hosted WAHA (devlikeape/waha) instance and a Z-API
# (z-api.cloud) instance, respectively (below).

# WAHA (devlikeape/waha) BYO adapter — F5.4. Pure self-host, no PalmUP
# broker/admin token involved. WAHA_SESSION defaults to "default" if unset.
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default

# Z-API (z-api.cloud) BYO adapter — F5.5. Pure BYO instance, no PalmUP
# broker/admin token involved.
ZAPI_BASE_URL=
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=

# License client (F4.1) — talks to the private PalmUP license server. Leave
# LICENSE_KEY/LICENSE_ACCOUNT_IDENTITY empty in dev: the module and its
# heartbeat scheduler no-op entirely when they're unset.
LICENSE_SERVER_URL=https://wpptrack-api.rastrack.app
# Received by email/WhatsApp after purchase. Do not commit a real value.
LICENSE_KEY=
# The admin account email this license is bound to.
LICENSE_ACCOUNT_IDENTITY=

# NOD API broker (PalmUP-managed Uazapi fleet via license key — F5.3b)
# Uses LICENSE_KEY + fingerprint; never set UAZAPI_ADMIN_TOKEN here.
NOD_API_BROKER_URL=https://wpptrack-api.rastrack.app

# WhatsApp disconnect alerts (F5.7) — streak of consecutive disconnected
# health checks before alerting once per streak; in-memory (resets on restart).
DISCONNECT_ALERTS_ENABLED=false
DISCONNECT_ALERT_STREAK=3
DISCONNECT_ALERT_INTERVAL_MS=900000
OPS_ALERT_WEBHOOK_URL=
