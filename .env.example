NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3333
API_PUBLIC_URL=http://localhost:3333
API_PORT=3333
# Installed version (/backoffice): the Docker build reads the commit from the
# git checkout automatically. Do not set GIT_SHA here — a runtime value is
# ignored. See docs/setup/update.md#versão-instalada.
# ⚠️ Gatilhos de conversão (obrigatório no caminho do aluno / produção):
# INBOUND_WEBHOOKS_ENABLED, INBOUND_WEBHOOK_PRODUCTION_ENABLED e
# INBOUND_CONVERSION_RULES_ENABLED vêm "true" (obrigatórias no Dokploy/produção
# do aluno) e INBOUND_WEBHOOK_ENCRYPTION_KEY precisa ser preenchida. Sem isso,
# "Gatilhos de conversão -> Nova regra" (UAZAPI, NOD API, WAHA, Z-API, Umbler,
# Gupshup e qualquer origem que use gatilhos) não aparece. Checklist completo:
# docs/setup/environment.md#gatilhos-de-conversão--obrigatórias-no-caminho-do-aluno
# Obrigatória no Dokploy/produção do aluno.
INBOUND_WEBHOOKS_ENABLED=true
# Base64 de 32 bytes (44 caracteres terminando em "="). Gere com:
# node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
INBOUND_WEBHOOK_ENCRYPTION_KEY=
# Recuperacao por owner: habilitacao opcional e explicita pelo operador.
# Usa previa + confirmacao + um teste entregue antes dos demais (ate 500).
# Nao habilite para contornar UNKNOWN; docs/setup/meta-cloud-recovery.md.
INBOUND_WEBHOOK_REPLAY_ENABLED=false
# Obrigatórias no Dokploy/produção do aluno (novos envios em produção, com
# inbound e criptografia). Replay não é requisito e continua desligado.
INBOUND_WEBHOOK_PRODUCTION_ENABLED=true
INBOUND_CONVERSION_RULES_ENABLED=true
# Produção direta (Fase 6.1c): deixe vazio. Sem valor, o envio das regras
# acompanha INBOUND_CONVERSION_RULES_ENABLED (o que foi validado no SaaS já
# chega enviando). "false" explícito desliga o envio de todas as regras,
# inclusive Kommo e Pipedrive (a tela Conversões avisa "Envio desligado no
# servidor"). Desde a 1.3.1 os movimentos da Kommo e do Pipedrive que chegam
# assim esperam até 7 dias e saem sozinhos quando o envio é religado.
INBOUND_CONVERSION_PRODUCTION_ENABLED=
# "Lead recebido pela regra" (Fase 6.2a, porte do SaaS #155): deixe vazio.
# Sem valor = LIGADA (produção direta: validada em produção no SaaS). Uma regra
# de conversão "Lead recebido" ativa e enviando passa a enviar o Lead recebido
# dos números que ela cobre quando for acionada, em vez de enviar na entrada da
# conversa (nunca os dois). "false" (ou 0/off/no) volta ao comportamento
# anterior: o Lead recebido sempre sai na entrada.
LEAD_SUBMITTED_RULE_OVERRIDE_ENABLED=
WPPTRACK_API_SLOW_REQUEST_MS=1500
WPPTRACK_API_SLOW_REPORT_QUERY_MS=750
WPPTRACK_WEB_SLOW_REQUEST_MS=1500
# WEB (opcional): tempo máximo, em ms, de cada leitura de status ou de
# atividade das conexões WhatsApp em Integrações (padrão 2000).
WPPTRACK_WEB_PROVIDER_STATUS_TIMEOUT_MS=2000
WPPTRACK_EXTERNAL_SYNC_ENABLED=true
WPPTRACK_EXTERNAL_SYNC_INTERVAL_MINUTES=1
WPPTRACK_EXTERNAL_SYNC_INITIAL_DELAY_SECONDS=60
WPPTRACK_EXTERNAL_SYNC_CONNECTOR_LIMIT=50
WPPTRACK_EXTERNAL_SYNC_ROW_BATCH_SIZE=200
WPPTRACK_EXTERNAL_MYSQL_CONNECT_TIMEOUT_MS=5000
WPPTRACK_EXTERNAL_MYSQL_QUERY_TIMEOUT_MS=10000

DATABASE_URL=postgresql://rastrackdash:rastrackdash@localhost:5432/rastrackdash
REDIS_URL=redis://localhost:6379
EXTERNAL_CONNECTOR_ENCRYPTION_KEY=replace-me-external-connector-encryption-key

JWT_ACCESS_SECRET=replace-me-access-secret
JWT_REFRESH_SECRET=replace-me-refresh-secret
AUTH_PUBLIC_REGISTRATION_ENABLED=false
AUTH_GOOGLE_ENABLED=false
AUTH_COOKIE_DOMAIN=localhost
AUTH_EXPOSE_DEV_TOKENS=false
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=RastrackDash
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_REPLY_TO=support@example.com

WPPTRACK_PLATFORM_ADMIN_EMAILS=

# First platform owner bootstrap (optional). Set both in the API service env;
# the account is created when the API starts. Remove the password after first use.
SETUP_PLATFORM_ADMIN_EMAIL=
SETUP_PLATFORM_ADMIN_PASSWORD=
# Set exactly "true" only to promote an existing account intentionally.
SETUP_PLATFORM_ADMIN_CONFIRM_EXISTING=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=replace-me-google-state-secret

META_APP_ID=
# App Secret do app Meta (NAO e o token permanente do Graph). Valida o header
# x-hub-signature-256. Opcional enquanto uma conexao "Meta WhatsApp (Cloud
# API)" estiver em observacao; OBRIGATORIO antes de ativar o envio automatico
# dessa conexao e antes da recuperacao. A ativacao bloqueia se estiver vazio;
# POSTs em producao sem assinatura valida continuam recusados com 404.
# Use somente o segredo do proprio app que entrega mensagens; nunca PalmUP.
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_TOKEN_ENCRYPTION_KEY=replace-me-meta-token-encryption-key
# Kommo CRM (opcional): Base64 canônico de 32 bytes; configure apenas no container da API.
# KOMMO_CRM_ENCRYPTION_KEY=
# Pipedrive CRM (opcional): Base64 de 32 bytes (openssl rand -base64 32), DIFERENTE da chave do Kommo;
# configure apenas no container da API. Definida e invalida (ou igual a do Kommo) = a API nao sobe.
PIPEDRIVE_CRM_ENCRYPTION_KEY=
# Usado SOMENTE pelo webhook de Meta Ads (/webhooks/meta). O webhook do
# Meta WhatsApp (Cloud API) usa um Verify token gerado por conexao na UI.
META_WEBHOOK_VERIFY_TOKEN=
WPPTRACK_META_AUTO_SYNC_ENABLED=true
WPPTRACK_META_AUTO_SYNC_INTERVAL_MINUTES=180
# Primeiro sync automatico apos o boot: vazio = aleatorio entre 10 e 30 min.
# Valores abaixo de 600 s sao ignorados (evita bater na Meta a cada redeploy).
WPPTRACK_META_AUTO_SYNC_INITIAL_DELAY_SECONDS=
# Miniaturas extras de video (GET /{video}/thumbnails): desligado por padrao
# para economizar o limite de chamadas do app Meta. So use "true" com app proprio.
# META_VIDEO_THUMBNAILS_ENABLED=false
# --- Limite de uso da Meta (Fase 6.4, todas opcionais; sem valor = padrao) ---
# A sincronizacao de relatorios cede a vez quando o app Meta (o da PalmUP no
# "Conectar Meta (PalmUP)" ou o seu proprio) passa deste uso, em %. Padrao 75.
# O limite e por app: o uso alto de um nao pausa o outro.
# WPPTRACK_META_USAGE_PAUSE_PERCENT=75
# Pedidos iguais de sincronizacao dentro desta janela (min) viram um so. Padrao 15.
# WPPTRACK_META_SYNC_DEDUPE_WINDOW_MINUTES=15
# Quantas vezes um job adia por limite antes de desistir (o proximo ciclo cobre). Padrao 12.
# WPPTRACK_META_SYNC_MAX_DEFERRALS=12
# Sync automatico incremental: 1 leitura completa por dia e, nas outras, so os
# ultimos N dias (confere com os totais da Meta; se nao fechar, le tudo). Padrao 3; 0 desliga.
# WPPTRACK_META_AUTO_SYNC_INCREMENTAL_DAYS=3
# Insights: legacy (padrao) | shadow (compara e registra no log) | ad_level (so nivel de anuncio).
# META_INSIGHTS_LEVEL_MODE=legacy
# Linhas por pagina dos Insights (volta para 100 se a Meta pedir menos). Padrao 500.
# META_INSIGHTS_PAGE_LIMIT=500
# Relatorio assincrono da Meta para periodos longos. Desligado por padrao.
# META_INSIGHTS_ASYNC_ENABLED=false
# META_INSIGHTS_ASYNC_MIN_DAYS=31
# META_INSIGHTS_ASYNC_POLL_MS=3000
# META_INSIGHTS_ASYNC_MAX_POLLS=40
# CAPI em lote (eventos simultaneos do mesmo pixel em 1 envio). Desligado por padrao;
# so junta eventos com WPPTRACK_CONVERSION_WORKER_CONCURRENCY maior que 1 (ex.: 4).
# META_CAPI_BATCH_ENABLED=false
# META_CAPI_BATCH_WINDOW_MS=250
# META_CAPI_BATCH_MAX_EVENTS=1000
# WPPTRACK_CONVERSION_WORKER_CONCURRENCY=1
# Primeiro nome do lead (fn, normalizado e com hash SHA-256) nos eventos CAPI.
# Desligado por padrao: o nome do perfil do WhatsApp nao e confiavel.
# "true" liga (basta reiniciar a API).
# META_CAPI_SEND_FIRST_NAME=false
WPPTRACK_META_AUTO_SYNC_LOOKBACK_DAYS=7
WPPTRACK_META_AUTO_SYNC_BATCH_LIMIT=100
WPPTRACK_REPORT_TIMEZONE=America/Sao_Paulo
# Cotacao PTAX do Banco Central para os relatorios por moeda (opcional,
# desligada por padrao). Ligue (true) so se anuncia ou vende em USD/EUR: a API
# busca a cada 6 h em olinda.bcb.gov.br (precisa de saida HTTPS para la).
# Desligada: nenhuma chamada externa; venda em outra moeda fica "sem cotacao".
# PTAX_SYNC_ENABLED=false

UAZAPI_BASE_URL=
UAZAPI_TOKEN=
UAZAPI_WEBHOOK_AUTH_TOKEN=

# WhatsApp providers (F5 plan, apps/api/src/integrations/whatsapp-providers):
# uazapi_byo uses the UAZAPI_* vars above (your own Uazapi instance token).
# nod_api is the PalmUP-managed broker (below). waha and zapi are pure BYO
# adapters for a self-hosted WAHA (devlikeape/waha) instance and a Z-API
# (z-api.cloud) instance, respectively (below).

# WAHA (devlikeape/waha) BYO adapter — F5.4. Pure self-host, no PalmUP
# broker/admin token involved. WAHA_SESSION defaults to "default" if unset.
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default

# Z-API (z-api.cloud) BYO adapter — F5.5. Pure BYO instance, no PalmUP
# broker/admin token involved.
ZAPI_BASE_URL=
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=

# License client (F4.1) — talks to the private PalmUP license server. The
# student edition is fail-closed: with LICENSE_SERVER_URL set and no valid
# activation, reads work but every write answers 423. Clear LICENSE_SERVER_URL
# (not just the key) to develop this template with licensing switched off.
LICENSE_SERVER_URL=https://wpptrack-api.rastrack.app
# Received by email/WhatsApp after purchase. Do not commit a real value.
LICENSE_KEY=
# The admin account email this license is bound to.
LICENSE_ACCOUNT_IDENTITY=

# NOD API broker (PalmUP-managed Uazapi fleet via license key — F5.3b)
# Uses LICENSE_KEY + fingerprint; never set UAZAPI_ADMIN_TOKEN here.
NOD_API_BROKER_URL=https://wpptrack-api.rastrack.app

# "Conectar Meta (PalmUP)" social login. Public HTTPS origin of the PalmUP API
# (no path) — NOT a secret and NOT an App Secret. The PalmUP Meta app secret
# never goes on your server. Leave empty to keep only the permanent-token path.
PALMUP_META_BROKER_URL=https://wpptrack-api.rastrack.app

# WhatsApp disconnect alerts (F5.7) — streak of consecutive disconnected
# health checks before alerting once per streak; in-memory (resets on restart).
DISCONNECT_ALERTS_ENABLED=false
DISCONNECT_ALERT_STREAK=3
DISCONNECT_ALERT_INTERVAL_MS=900000
OPS_ALERT_WEBHOOK_URL=

# Alertas WhatsApp por workspace (Configurações > Alertas WhatsApp). Fase 6.1c:
# a API confere cada conexão Uazapi BYO e WAHA pela API de status do provedor
# e avisa "WhatsApp desconectado" em Integrações depois de 2 leituras seguidas.
# Opcional: para a mensagem sair por WhatsApp, informe uma instância Uazapi sua
# que envia o aviso (URL do servidor + token da instância; o token é segredo e
# fica só no ambiente da API). Sem elas, o aviso aparece só na tela.
OPS_ALERT_UAZAPI_BASE_URL=
OPS_ALERT_UAZAPI_TOKEN=
# Intervalo da conferência (mínimo 60000; padrão 15 minutos).
OPS_ALERT_SCAN_INTERVAL_MS=900000

# Whitelabel (F6.2) — student agency branding. Read server-side by
# apps/web/src/lib/brand.ts and passed as props into the (client) app shell;
# nothing here is exposed via NEXT_PUBLIC_. The footer residual
# ("RastrackDash · powered by PalmUP") is NOT controlled by any of these
# vars and cannot be hidden.
BRAND_NAME=
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
BRAND_PRIMARY_COLOR=#0F766E
